{
	"version": "2.0.0",
	"tasks": [
		// Native target build
		{
			"label": "build app",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build", "${workspaceFolder}/build",
				"-j", "${config:build_jobs}"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"],
			"dependsOn": "prepare build app"
		},
		{
			"label": "prepare build app",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S", "${workspaceFolder}",
				"-B", "${workspaceFolder}/build",
				"-DCMAKE_BUILD_TYPE=${config:cmake_build_type}"
			],
			"group": {
				"kind": "none"
			},
			"problemMatcher": ["$gcc"]
		},
		// Emscripten build task
		{
			"label": "build app [emscripten]",
			"type": "shell",
			"command": "bash",
			"args": [
				"-c",
				"source ${config:emsdk_env} && emcmake cmake -S ${workspaceFolder} -B ${workspaceFolder}/embuild -DCMAKE_BUILD_TYPE=${config:cmake_build_type} && cmake --build ${workspaceFolder}/embuild -j ${config:build_jobs}",
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"]
		}
	]
}